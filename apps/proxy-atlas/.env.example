# Copy to .env for production. Never commit .env.
PROXY_SITE_URL=https://aixianlu.com
PROXY_TZ=Asia/Shanghai

# 用于点击日志的 IP 哈希；生产环境请改成随机长字符串
PROXY_IP_SALT=change-this-random-salt

# Optional: used only when creating the first admin account.
# The default admin/admin is for local development only.
PROXY_ADMIN_USER=admin
PROXY_ADMIN_PASSWORD=change-this-password

# Optional: move the SQLite file outside the web root.
# PROXY_DB=/var/lib/proxy-atlas/proxy-atlas.sqlite

# SEO automation (optional)
# IndexNow key: generate with `openssl rand -hex 16`; bin/ping.php will expose
# https://your-domain/<key>.txt automatically and submit sitemap URLs to Bing.
INDEXNOW_KEY=
# Baidu search resource push token (optional).
BAIDU_PUSH_TOKEN=

# Optional: server-to-server conversion postback token.
# Endpoint: https://aixianlu.com/api/postback.php
POSTBACK_TOKEN=

# Optional: webhook for health alerts (Slack/Discord/Feishu/Telegram proxy).
ALERT_WEBHOOK_URL=

# Probe ingestion (PROTOCOL.md v0.2.0)
# Endpoint: POST https://aixianlu.com/api/v1/metrics/report
# Tokens are issued with `php bin/probe_token.php issue --label="电信-广东-01"`
# or in the admin panel (探针数据). Only their SHA-256 hash is stored.
PROBE_MIN_INTERVAL_SECONDS=60
PROBE_HOURLY_LIMIT=120
PROBE_TIMESTAMP_SKEW_SECONDS=300
PROBE_MAX_RESULTS=200
PROBE_MAX_BODY_BYTES=262144
# Set to 1 only while migrating old 0.1.x probes that cannot sign reports.
PROBE_ALLOW_UNSIGNED=0
